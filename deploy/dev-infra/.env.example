# 复制为 deploy/dev-infra/.env（不入库）。./deploy/cairn dev-infra up 会在缺失时生成密钥，并把清单里的端口写进来。

CAIRN_DB_USER=cairn
CAIRN_DB_PASSWORD=
CAIRN_DB_NAME=cairn

CAIRN_S3_ACCESS_KEY=
CAIRN_S3_SECRET_KEY=
CAIRN_S3_REGION=us-east-1
CAIRN_S3_BUCKET=cairn-dev-evidence

BIND_ADDR=0.0.0.0
DEV_PG_PORT=25432
DEV_REDIS_PORT=26380
DEV_S3_PORT=19031
DEV_S3_CONSOLE_PORT=19032
