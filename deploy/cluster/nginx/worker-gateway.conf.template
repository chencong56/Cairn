# Worker 内部入口网关（与 Worker 容器共享网络命名空间）
# Worker 进程只允许监听容器内 loopback:8091；本网关在同一命名空间监听 ${GATEWAY_PORT}，
# 由 compose 端口映射发布到宿主内网 IP，供 API 经 HMAC 定向调用。
# 铁律：保留内部签名头与原始请求体；不缓冲；超时不短于 认证 POST 30s。
server {
    listen ${GATEWAY_PORT};
    server_name _;

    client_max_body_size 150m;

    location / {
        proxy_pass http://127.0.0.1:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
