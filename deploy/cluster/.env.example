# Cairn 集群部署环境变量模板
# 复制为 /data/wp/cairn/cluster/deploy/.env（0640 root:wp），三台共用同一份密钥，
# 仅 HOST_IP / HOST_SHORT 按主机替换。生成方式见各项注释，密钥一律 openssl 随机生成。

# ── 镜像与主机标识 ──
# 运行时底座镜像 tag（Node24+Chromium+字体+原生库，慢变；应用产物挂载运行，见 apps/）
CAIRN_RUNTIME_TAG=
# 本机内网 IP（ah2=192.168.3.202 / ah3=192.168.3.203 / ah4=192.168.3.204）
HOST_IP=
# 本机短名（ah2 / ah3 / ah4）
HOST_SHORT=
TZ=Asia/Shanghai
# 可观测：构建版本随镜像 tag 注入
CAIRN_BUILD_VERSION=

# ── 数据库（ah3 新实例 cairn-pg，宿主端口 15432）──
CAIRN_DB_DRIVER=postgres
CAIRN_DB_HOST=192.168.3.203
CAIRN_DB_PORT=15432
CAIRN_DB_NAME=cairn
CAIRN_DB_USER=cairn
# openssl rand -base64 24
CAIRN_DB_PASSWORD=
CAIRN_DB_SCHEMA=cairn

# ── 平台密钥（全实例一致，一次性生成）──
# openssl rand -base64 48
CAIRN_JWT_SECRET=
CAIRN_JWT_EXPIRES_IN=12h
# openssl rand -base64 32（AES-256-GCM 主密钥，API 写 / Worker 解必须同把）
CAIRN_CREDENTIAL_KEY=
# openssl rand -base64 32（API↔Worker HMAC）
CAIRN_INTERNAL_AUTH_SECRET=

# ── 对象存储（ah3 新实例 cairn-rustfs2，宿主 9031/9032；path-style）──
CAIRN_OBJECT_STORE=s3
CAIRN_S3_ENDPOINT=http://192.168.3.203:9031
CAIRN_S3_REGION=us-east-1
CAIRN_S3_BUCKET=cairn-evidence
# 与下方 RUSTFS_* 同值；openssl rand -hex 20 / openssl rand -base64 32
CAIRN_S3_ACCESS_KEY=
CAIRN_S3_SECRET_KEY=
CAIRN_S3_FORCE_PATH_STYLE=true

# ── 变化提示（PG 走 LISTEN/NOTIFY；Redis 仅缓存与扇出辅助）──
CAIRN_CHANGE_HINT=auto
CAIRN_REDIS_URL=redis://192.168.3.203:16380

# ── API（ah3）──
CAIRN_API_PORT=3030
CAIRN_CORS_ORIGINS=http://192.168.3.203
CAIRN_TRUST_PROXY_HOPS=1

# ── Worker 通用（各实例 ID/角色/入口在 compose 里按服务注入）──
CAIRN_BROWSER_HEADLESS=true
CAIRN_BROWSER_PROFILE_DIR=/data/cairn/browser-profiles
# 用户决策：每台 executor 并发 2；会话上限 = 并发 + 1 保活/认证等待余量
CAIRN_WORKER_CAPACITY=2
CAIRN_BROWSER_MAX_SESSIONS=3

# ── RustFS 容器环境（仅 ah3 core.compose 使用，与 CAIRN_S3_* 同值）──
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
