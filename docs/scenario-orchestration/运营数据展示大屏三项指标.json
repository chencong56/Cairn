      {
        "kind": "step",
        "step": {
          "id": "d4000004-0000-4000-8000-000000000008",
          "name": "选择项目经理操作台",
          "type": "ai_action",
          "input": {
            "instruction": "当前页面上有标题为「我的专属操作台」的弹窗，列出「客户经理操作台」「增长操作台」「区域经理操作台」「项目经理操作台」四行，每行右侧有「设为主界面」开关，弹窗底部有「取消」和「确认更改」两个按钮。请点击第四行的「项目经理操作台」文字，使项目经理操作台生效并进入大屏页面。不要点「取消」，不要点其它操作台，不要再点顶部的「个人操作台」标签。"
          },
          "effectType": "SIDE_EFFECT"
        }
