# cairn-env-profile: remote
# 远端开发组件画像（公开项，入库）。密钥在 .env.remote.secrets。
# Mac 走 Tailscale：gs1=100.64.0.8。不要填发布栈 15432 / 16380 / 9031。
# 日常：pnpm dev:env use remote
# 组件：./deploy/cairn dev-infra up → gs1 /home/cairn → cairn-dev-pg :25432 / redis :26380 / rustfs :19031

# ══════════════════════════════════════════════════════════════
# 1. 平台全局与运行环境 (Global Runtime)
# ══════════════════════════════════════════════════════════════
# CAIRN_LOG_LEVEL=info
# CAIRN_BUILD_VERSION=

# ══════════════════════════════════════════════════════════════
# 2. 数据库基础设施 (Database - API / Worker / 迁移共用)
# ══════════════════════════════════════════════════════════════
CAIRN_DB_DRIVER=postgres
# CAIRN_DB_FILE=.data/cairn.sqlite
CAIRN_DB_HOST=100.64.0.8
CAIRN_DB_PORT=25432
# 测试专用 PG（容器 cairn-postgres-test，内存盘）：集成测试只连它，不碰开发库。pnpm infra:up 一并启动
CAIRN_TEST_DB_HOST=127.0.0.1
CAIRN_TEST_DB_PORT=5442
CAIRN_DB_NAME=cairn
CAIRN_DB_USER=cairn
CAIRN_DB_SCHEMA=cairn

# ══════════════════════════════════════════════════════════════
# 3. 平台根密钥与内部安全 (Platform Secrets & Auth)
# ══════════════════════════════════════════════════════════════
CAIRN_JWT_EXPIRES_IN=12h

# ══════════════════════════════════════════════════════════════
# 4. 公共对象存储设施 (Object Store - API / Worker 共用)
# ══════════════════════════════════════════════════════════════
CAIRN_OBJECT_STORE=s3
# CAIRN_OBJECT_STORE_DIR=.data/object-store
CAIRN_OBJECT_MAX_BYTES=32MB
CAIRN_OBJECT_RETAIN_DAYS=30
CAIRN_OBJECT_PENDING_TTL_SECONDS=3600
CAIRN_OBJECT_CLEANUP_INTERVAL_MS=60000
CAIRN_TRACE_MAX_BYTES=128MB
CAIRN_VIDEO_MAX_BYTES=128MB
CAIRN_EVIDENCE_UPLOAD_MAX_ATTEMPTS=3
CAIRN_S3_ENDPOINT=http://100.64.0.8:19031
CAIRN_S3_REGION=us-east-1
CAIRN_S3_BUCKET=cairn-dev-evidence
CAIRN_S3_FORCE_PATH_STYLE=true

# ══════════════════════════════════════════════════════════════
# 5. 实时变化提示与遥测总线 (Observe, Event Bus & Telemetry)
# ══════════════════════════════════════════════════════════════
CAIRN_CHANGE_HINT=auto
CAIRN_REDIS_URL=redis://100.64.0.8:26380
# CAIRN_CHANGE_HINT_NAMESPACE=
# CAIRN_RUN_EVENT_RETAIN_DAYS=7
# CAIRN_MONITOR_SSE_INTERVAL_MS=5000
# CAIRN_MONITOR_SSE_MIN_INTERVAL_MS=5000
# CAIRN_MONITOR_OVERVIEW_CACHE_MS=3000
# CAIRN_MONITOR_SAMPLE_INTERVAL_MS=60000
# CAIRN_MONITOR_SAMPLE_RETENTION_DAYS=30
# CAIRN_MONITOR_AI_CALL_RETENTION_DAYS=90
# CAIRN_MONITOR_DISK_SAMPLE_MS=60000
# CAIRN_MONITOR_OBJECT_STORE_PROBE_MS=60000
# CAIRN_MONITOR_PURGE_INTERVAL_MS=600000

# ══════════════════════════════════════════════════════════════
# 6. 控制面（API 进程专属）
# ══════════════════════════════════════════════════════════════
CAIRN_API_PORT=3030
CAIRN_API_ORIGIN=http://127.0.0.1:3030
CAIRN_WEB_PORT=5173
CAIRN_CORS_ORIGINS=http://localhost:5173
CAIRN_TRUST_PROXY_HOPS=0
# CAIRN_API_ID=
# CAIRN_API_HEARTBEAT_MS=5000
# CAIRN_API_LOST_AFTER_SECONDS=45


# ══════════════════════════════════════════════════════════════
# 7. 执行面（Worker 进程专属）
# ══════════════════════════════════════════════════════════════
# ── 7.1 节点身份与任务调度 (Fleet & Lease) ──
CAIRN_WORKER_ID=
CAIRN_WORKER_CAPACITY=1
# CAIRN_WORKER_ROLES=all
# CAIRN_WORKER_ROLE_ID_PREFIX=local-worker
# CAIRN_WORKER_EXECUTOR_PORT=8092
# CAIRN_WORKER_SCHEDULER_PORT=8093
# CAIRN_WORKER_ANALYST_PORT=8094
# CAIRN_WORKER_MAINTENANCE_PORT=8095
CAIRN_WORKER_INTERNAL_HOST=127.0.0.1
CAIRN_WORKER_INTERNAL_PORT=8091
CAIRN_WORKER_ADVERTISE_URL=
CAIRN_WORKER_HEARTBEAT_MS=5000
CAIRN_RUN_LEASE_TTL_SECONDS=30
CAIRN_WORKER_LOST_AFTER_SECONDS=45
CAIRN_RUN_MAX_RECOVERIES=3
# CAIRN_PERIODIC_SLOT_LEASE_TTL_MS=60000
# CAIRN_PERIODIC_SLOT_FAILURE_RETRY_MS=5000
# CAIRN_REAPER_DRAIN_BUDGET_MS=5000
# CAIRN_CREDENTIAL_REMINDER_SCAN_INTERVAL_MS=60000

# ── 7.2 受管浏览器与会话基础设施 (Browser Runtime Infrastructure) ──
CAIRN_BROWSER_HEADLESS=true
CAIRN_BROWSER_PROFILE_DIR=.data/browser-profiles
CAIRN_BROWSER_MAX_SESSIONS=2
CAIRN_BROWSER_EXECUTABLE_PATH=
CAIRN_SESSION_LEASE_TTL_SECONDS=30
CAIRN_SESSION_HEARTBEAT_MS=5000
CAIRN_SESSION_REAPER_INTERVAL_MS=15000

# ── 7.3 执行面高级运行保护与网络出口 (Execution Protection & Egress) ──
CAIRN_BROWSER_AI_HANG_WAIT_MS=5000

# ══════════════════════════════════════════════════════════════
# 8. 编写与特性闸门 (Authoring & Feature Flags)
# ══════════════════════════════════════════════════════════════
CAIRN_DEMONSTRATION_ENABLED=true
