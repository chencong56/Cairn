{
  "name": "@cairn/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/browser/video-encoder-child.cjs dist/browser/video-encoder-child.cjs",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts && vitest run --config vitest.db.config.mts && vitest run --config vitest.browser.config.mts",
    "test:fast": "vitest run --config vitest.config.mts",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:browser": "vitest run --config vitest.browser.config.mts",
    "test:live": "vitest run --config vitest.live.config.mts",
    "test:demo": "vitest run --config vitest.demo.config.mts",
    "test:soak": "CAIRN_SOAK_ITERS=20 vitest run --config vitest.browser.config.mts src/browser/surface.lab.spec.ts",
    "browser:install": "playwright install chromium",
    "dev": "pnpm run build && concurrently -k -n tsc,node -c blue,green \"tsc -w --preserveWatchOutput -p tsconfig.build.json\" \"node --watch --watch-preserve-output dist/main.js\"",
    "register-ai-secret": "node dist/bin/register-browser-ai-secret.js"
  },
  "dependencies": {
    "@cairn/authoring": "workspace:*",
    "@cairn/db": "workspace:*",
    "@cairn/map": "workspace:*",
    "@cairn/secret": "workspace:*",
    "@cairn/shared": "workspace:*",
    "@cairn/storage": "workspace:*",
    "@ffmpeg/core": "0.11.0",
    "@midscene/core": "1.12.6",
    "@midscene/shared": "1.12.6",
    "@midscene/web": "1.12.6",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "nestjs-pino": "^5.1.0",
    "nodemailer": "^10.0.10",
    "onnxruntime-node": "^1.30.0",
    "pino": "^10.3.1",
    "playwright": "1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.2",
    "@types/jpeg-js": "^0.3.7",
    "@types/node": "^25.9.5",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "jpeg-js": "^0.4.4",
    "smtp-server": "^3.19.13",
    "typescript": "~6.0.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.11"
  }
}
